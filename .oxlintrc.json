{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "import", "promise", "typescript", "unicorn", "vue", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off"
  },
  "rules": {
    "no-debugger": "error",
    "no-console": "warn",
    "no-unused-vars": "off",
    "no-useless-escape": "warn",
    "no-empty": "warn",
    "no-prototype-builtins": "off",
    "no-undef": "off",
    "no-unused-expressions": "off",
    "eqeqeq": "error",
    "no-eval": "error",
    "no-new-wrappers": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-optional-chaining": "error",
    "no-extra-boolean-cast": "warn",
    "no-const-assign": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty-pattern": "warn",
    "no-ex-assign": "error",
    "no-fallthrough": "error",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "warn",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-obj-calls": "error",
    "no-sparse-arrays": "error",
    "no-unexpected-multiline": "error",
    "no-unreachable": "error",
    "no-unsafe-negation": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "prefer-const": "warn",
    "no-var": "error",
    "prefer-arrow-callback": "warn",
    "prefer-spread": "warn",
    "prefer-template": "warn",
    "no-array-constructor": "warn",
    "no-duplicate-imports": "warn",
    "no-self-compare": "warn",
    "no-shadow-restricted-names": "error",
    "no-async-promise-executor": "error",
    "no-await-in-loop": "warn",
    "no-promise-executor-return": "warn",
    "require-await": "warn",
    "getter-return": "error",
    "for-direction": "error",
    "default-case-last": "warn",
    "no-case-declarations": "warn",
    "no-constant-binary-expression": "error",
    "no-self-assign": "warn",
    "no-compare-neg-zero": "error",
    "no-sequences": "warn",
    "no-throw-literal": "error",
    "no-unmodified-loop-condition": "warn",
    "no-useless-catch": "warn",
    "no-with": "error",
    "radix": "warn",
    "no-nonoctal-decimal-escape": "warn",
    "prefer-numeric-literals": "warn",
    "no-import-assign": "error",
    "no-new-native-nonconstructor": "error",
    "no-this-before-super": "error",
    "no-unreachable-loop": "warn",
    "no-use-before-define": "warn",
    "no-class-assign": "error",
    "no-param-reassign": "warn",
    "no-negated-condition": "warn",
    "max-params": ["warn", 4],
    "no-magic-numbers": "off",
    "no-ternary": "off",
    "no-warning-comments": "warn",
    "no-alert": "warn",
    "no-implicit-coercion": "warn",
    "no-return-assign": "warn",
    "no-void": "off",
    "no-script-url": "warn",
    "no-iterator": "error",
    "no-proto": "error",
    "no-multi-assign": "warn",
    "no-new": "warn",
    "no-new-func": "error",
    "no-caller": "error",
    "no-labels": "warn",
    "no-lone-blocks": "warn",
    "no-multi-str": "error",
    "no-redeclare": "warn",
    "no-underscore-dangle": "off",
    "no-unneeded-ternary": "warn",
    "consistent-return": "warn",
    "curly": "warn",
    "dot-notation": "warn",
    "yoda": "warn",
    "no-bitwise": "warn",
    "no-continue": "off",
    "no-div-regex": "warn",
    "no-else-return": "warn",
    "no-label-var": "warn",
    "no-plusplus": "off",
    "no-useless-concat": "warn",
    "no-useless-constructor": "warn",
    "no-useless-rename": "warn",
    "object-shorthand": "warn",
    "prefer-destructuring": "warn",
    "prefer-exponentiation-operator": "warn",
    "prefer-object-spread": "warn",
    "prefer-rest-params": "warn",
    "sort-vars": "off",
    "symbol-description": "warn",
    "vars-on-top": "off",
    "prefer-regex-literals": "warn",
    "grouped-accessor-pairs": "warn",
    "no-constructor-return": "error",
    "no-implicit-globals": "warn",
    "no-inner-declarations": "warn",
    "no-template-curly-in-string": "warn",
    "no-setter-return": "error",
    "no-unassigned-vars": "warn",
    "no-useless-backreference": "warn",
    "require-yield": "warn",
    "no-dupe-class-members": "error",
    "no-dupe-else-if": "error",
    "no-empty-character-class": "warn",
    "no-extend-native": "warn",
    "accessor-pairs": "warn",
    "array-callback-return": "warn",
    "constructor-super": "error",
    "default-case": "warn",
    "default-param-last": "warn",
    "global-require": "off",
    "guard-for-in": "warn",
    "logical-assignment-operators": "warn",
    "max-classes-per-file": "off",
    "max-depth": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-nested-callbacks": "off",
    "max-statements": "off",
    "new-cap": "off",
    "no-constant-condition": "warn",
    "no-control-regex": "warn",
    "no-delete-var": "error",
    "no-empty-function": ["warn", { "allow": ["arrowFunctions"] }],
    "no-empty-static-block": "warn",
    "no-eq-null": "warn",
    "no-extra-label": "warn",
    "no-implied-eval": "error",
    "no-inline-comments": "off",
    "no-lonely-if": "warn",
    "no-nested-ternary": "off",
    "no-new-require": "error",
    "no-path-concat": "off",
    "no-regex-spaces": "warn",
    "no-restricted-exports": "off",
    "no-restricted-globals": "off",
    "no-restricted-imports": "off",
    "no-restricted-properties": "off",
    "no-shadow": "off",
    "no-undefined": "off",
    "no-unused-labels": "warn",
    "no-unused-private-class-members": "warn",
    "no-useless-assignment": "warn",
    "no-useless-call": "warn",
    "no-useless-computed-key": "warn",
    "no-useless-return": "warn",
    "operator-assignment": "warn",
    "prefer-object-has-own": "warn",
    "prefer-promise-reject-errors": "warn",
    "sort-imports": "off",
    "sort-keys": "off",

    "typescript/consistent-type-imports": ["warn", { "fixStyle": "inline-type-imports" }],
    "typescript/consistent-type-definitions": ["warn", "interface"],
    "typescript/array-type": ["warn", { "default": "array-simple" }],
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-empty-object-type": "warn",
    "typescript/no-inferrable-types": "warn",
    "typescript/no-var-requires": "warn",
    "typescript/prefer-nullish-coalescing": "warn",

    "import/no-duplicates": "warn",
    "import/no-self-import": "error",
    "import/no-empty-named-blocks": "warn",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default-member": "off",
    "import/consistent-type-specifier-style": ["warn", "prefer-inline"],

    "promise/no-return-wrap": "warn",

    "unicorn/prefer-number-properties": "warn",
    "unicorn/no-instanceof-array": "warn",
    "unicorn/prefer-add-event-listener": "warn",
    "unicorn/prefer-includes": "warn",
    "unicorn/prefer-optional-catch-binding": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn",
    "unicorn/throw-new-error": "warn",

    "vue/no-import-compiler-macros": "error",
    "vue/require-typed-ref": "warn",
    "vue/define-props-destructuring": "off",
    "vue/no-required-prop-with-default": "warn",
    "vue/require-default-prop": "warn",
    "vue/require-prop-types": "warn",
    "vue/component-definition-name-casing": ["warn", "PascalCase"],
    "vue/max-props": ["warn", { "maxProps": 5 }],

    "vitest/no-identical-title": "warn",
    "vitest/no-commented-out-tests": "warn"
  },
  "globals": {
    "getCurrentPages": "readonly",
    "NodeJS": "readonly"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    ".vscode/",
    "auto-imports.d.ts",
    "components.d.ts",
    "*.d.ts"
  ]
}
